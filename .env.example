# LearnUs account
LEARNUS_USERNAME=your_yonsei_id_here
LEARNUS_PASSWORD=your_password_here

# Whisper transcription
WHISPER_MODEL=medium
WHISPER_LANGUAGE=auto
WHISPER_BACKEND=auto

# Optional: set this when you want to use a specific ffmpeg executable.
# FFMPEG_PATH=C:\path\to\ffmpeg.exe

# Optional: local summarizer endpoint.
# SUMMARIZER_PROVIDER=ollama
# SUMMARIZER_BASE_URL=http://localhost:11434
# SUMMARIZER_MODEL=llama2
